{
  "openapi" : "3.1.0",
  "info" : {
    "description" : "HTTP contract for the Student Manager UI. Spring Boot owns this contract; the React app generates TypeScript types from the exported OpenAPI document.",
    "title" : "Student Manager API",
    "version" : "v1"
  },
  "servers" : [ {
    "url" : "/",
    "description" : "Same origin as the bundled UI"
  } ],
  "tags" : [ {
    "description" : "Student–course enrollment operations",
    "name" : "Enrollments"
  }, {
    "description" : "Authenticated caller identity",
    "name" : "Current user"
  }, {
    "description" : "Course collection operations",
    "name" : "Courses"
  }, {
    "description" : "Student collection operations",
    "name" : "Students"
  } ],
  "paths" : {
    "/api/v1/courses" : {
      "get" : {
        "operationId" : "getAllCourses",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/CourseResponse"
                  }
                }
              }
            },
            "description" : "Courses"
          }
        },
        "summary" : "List all courses",
        "tags" : [ "Courses" ]
      },
      "post" : {
        "operationId" : "addCourse",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CourseRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "description" : "Created"
          },
          "400" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description" : "Validation or business rule failure"
          }
        },
        "summary" : "Create a course",
        "tags" : [ "Courses" ]
      }
    },
    "/api/v1/courses/{courseId}" : {
      "delete" : {
        "operationId" : "deleteCourse",
        "parameters" : [ {
          "in" : "path",
          "name" : "courseId",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        } ],
        "responses" : {
          "204" : {
            "description" : "Deleted"
          },
          "404" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description" : "Course not found"
          }
        },
        "summary" : "Delete a course by id",
        "tags" : [ "Courses" ]
      },
      "put" : {
        "operationId" : "updateCourse",
        "parameters" : [ {
          "in" : "path",
          "name" : "courseId",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CourseRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "204" : {
            "description" : "Updated"
          },
          "400" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description" : "Validation or business rule failure"
          },
          "404" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description" : "Course not found"
          },
          "409" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description" : "Capacity below existing enrollment count"
          }
        },
        "summary" : "Update a course by id",
        "tags" : [ "Courses" ]
      }
    },
    "/api/v1/enrollments" : {
      "get" : {
        "operationId" : "getAllEnrollments",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/EnrollmentResponse"
                  }
                }
              }
            },
            "description" : "Enrollments"
          }
        },
        "summary" : "List all enrollments",
        "tags" : [ "Enrollments" ]
      },
      "post" : {
        "operationId" : "enroll",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/EnrollmentRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "description" : "Created"
          },
          "400" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description" : "Validation, duplicate, or capacity failure"
          },
          "404" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description" : "Student or course not found"
          }
        },
        "summary" : "Enroll a student in a course",
        "tags" : [ "Enrollments" ]
      }
    },
    "/api/v1/enrollments/{enrollmentId}" : {
      "delete" : {
        "operationId" : "deleteEnrollment",
        "parameters" : [ {
          "in" : "path",
          "name" : "enrollmentId",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        } ],
        "responses" : {
          "204" : {
            "description" : "Deleted"
          },
          "404" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description" : "Enrollment not found"
          }
        },
        "summary" : "Cancel an enrollment by id",
        "tags" : [ "Enrollments" ]
      }
    },
    "/api/v1/me" : {
      "get" : {
        "operationId" : "getCurrentUser",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CurrentUserResponse"
                }
              }
            },
            "description" : "Current user"
          },
          "401" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CurrentUserResponse"
                }
              }
            },
            "description" : "Unauthenticated"
          }
        },
        "summary" : "Get the authenticated user",
        "tags" : [ "Current user" ]
      }
    },
    "/api/v1/students" : {
      "get" : {
        "operationId" : "getAllStudents",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/StudentResponse"
                  }
                }
              }
            },
            "description" : "Students"
          }
        },
        "summary" : "List all students",
        "tags" : [ "Students" ]
      },
      "post" : {
        "operationId" : "addStudent",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/StudentRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "description" : "Created"
          },
          "400" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description" : "Validation or business rule failure"
          }
        },
        "summary" : "Create a student",
        "tags" : [ "Students" ]
      }
    },
    "/api/v1/students/{studentId}" : {
      "delete" : {
        "operationId" : "deleteStudent",
        "parameters" : [ {
          "in" : "path",
          "name" : "studentId",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        } ],
        "responses" : {
          "204" : {
            "description" : "Deleted"
          },
          "404" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description" : "Student not found"
          }
        },
        "summary" : "Delete a student by id",
        "tags" : [ "Students" ]
      },
      "put" : {
        "operationId" : "updateStudent",
        "parameters" : [ {
          "in" : "path",
          "name" : "studentId",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/StudentRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "204" : {
            "description" : "Updated"
          },
          "400" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description" : "Validation or business rule failure"
          },
          "404" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiErrorResponse"
                }
              }
            },
            "description" : "Student not found"
          }
        },
        "summary" : "Update a student by id",
        "tags" : [ "Students" ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "ApiErrorResponse" : {
        "type" : "object",
        "description" : "Structured API error body",
        "properties" : {
          "code" : {
            "type" : "string",
            "description" : "Stable error code for clients",
            "enum" : [ "EMAIL_TAKEN", "STUDENT_NOT_FOUND", "COURSE_NOT_FOUND", "ENROLLMENT_NOT_FOUND", "DUPLICATE_ENROLLMENT", "COURSE_FULL", "COURSE_CAPACITY_BELOW_ENROLLMENT_COUNT", "VALIDATION_FAILED", "BAD_REQUEST" ]
          },
          "error" : {
            "type" : "string",
            "description" : "HTTP reason phrase",
            "example" : "Bad Request"
          },
          "message" : {
            "type" : "string",
            "description" : "Diagnostic detail (not primary UI copy for known codes)",
            "example" : "Email ada@example.com taken"
          },
          "status" : {
            "type" : "integer",
            "format" : "int32",
            "description" : "HTTP status code",
            "example" : 400
          }
        },
        "required" : [ "code", "error", "message", "status" ]
      },
      "CourseRequest" : {
        "type" : "object",
        "description" : "Payload to create or update a course",
        "properties" : {
          "capacity" : {
            "type" : "integer",
            "format" : "int32",
            "description" : "Maximum number of seats",
            "example" : 30,
            "minimum" : 1
          },
          "description" : {
            "type" : "string",
            "description" : "Optional course description",
            "example" : "Sorting, graphs, and complexity"
          },
          "title" : {
            "type" : "string",
            "description" : "Course title",
            "example" : "Intro to Algorithms",
            "minLength" : 1
          }
        },
        "required" : [ "capacity", "title" ]
      },
      "CourseResponse" : {
        "type" : "object",
        "description" : "Course as returned by the API",
        "properties" : {
          "capacity" : {
            "type" : "integer",
            "format" : "int32",
            "description" : "Maximum number of seats",
            "example" : 30,
            "minimum" : 1
          },
          "description" : {
            "type" : "string",
            "description" : "Optional course description",
            "example" : "Sorting, graphs, and complexity"
          },
          "id" : {
            "type" : "integer",
            "format" : "int64",
            "description" : "Course id",
            "example" : 1
          },
          "title" : {
            "type" : "string",
            "description" : "Course title",
            "example" : "Intro to Algorithms",
            "minLength" : 1
          }
        },
        "required" : [ "capacity", "id", "title" ]
      },
      "CurrentUserResponse" : {
        "type" : "object",
        "description" : "Currently authenticated user",
        "properties" : {
          "role" : {
            "type" : "string",
            "description" : "Application role",
            "enum" : [ "ADMIN", "USER" ]
          },
          "username" : {
            "type" : "string",
            "description" : "Username",
            "example" : "dev",
            "minLength" : 1
          }
        },
        "required" : [ "role", "username" ]
      },
      "EnrollmentRequest" : {
        "type" : "object",
        "description" : "Payload to enroll a student in a course",
        "properties" : {
          "courseId" : {
            "type" : "integer",
            "format" : "int64",
            "description" : "Course id",
            "example" : 1
          },
          "studentId" : {
            "type" : "integer",
            "format" : "int64",
            "description" : "Student id",
            "example" : 1
          }
        },
        "required" : [ "courseId", "studentId" ]
      },
      "EnrollmentResponse" : {
        "type" : "object",
        "description" : "Enrollment as returned by the API",
        "properties" : {
          "courseId" : {
            "type" : "integer",
            "format" : "int64",
            "description" : "Course id",
            "example" : 1
          },
          "enrolledAt" : {
            "type" : "string",
            "format" : "date-time",
            "description" : "Enrollment timestamp (UTC)",
            "example" : "2026-01-15T10:30:00Z"
          },
          "id" : {
            "type" : "integer",
            "format" : "int64",
            "description" : "Enrollment id",
            "example" : 1
          },
          "studentId" : {
            "type" : "integer",
            "format" : "int64",
            "description" : "Student id",
            "example" : 1
          }
        },
        "required" : [ "courseId", "enrolledAt", "id", "studentId" ]
      },
      "StudentRequest" : {
        "type" : "object",
        "description" : "Payload to create or update a student",
        "properties" : {
          "email" : {
            "type" : "string",
            "format" : "email",
            "description" : "Email address",
            "example" : "ada@example.com",
            "minLength" : 1
          },
          "gender" : {
            "type" : "string",
            "description" : "Gender",
            "enum" : [ "MALE", "FEMALE", "OTHER" ]
          },
          "name" : {
            "type" : "string",
            "description" : "Full name",
            "example" : "Ada Lovelace",
            "minLength" : 1
          }
        },
        "required" : [ "email", "gender", "name" ]
      },
      "StudentResponse" : {
        "type" : "object",
        "description" : "Student as returned by the API",
        "properties" : {
          "email" : {
            "type" : "string",
            "description" : "Email address",
            "example" : "ada@example.com",
            "minLength" : 1
          },
          "gender" : {
            "type" : "string",
            "description" : "Gender",
            "enum" : [ "MALE", "FEMALE", "OTHER" ]
          },
          "id" : {
            "type" : "integer",
            "format" : "int64",
            "description" : "Student id",
            "example" : 1
          },
          "name" : {
            "type" : "string",
            "description" : "Full name",
            "example" : "Ada Lovelace",
            "minLength" : 1
          }
        },
        "required" : [ "email", "gender", "id", "name" ]
      }
    }
  }
}
